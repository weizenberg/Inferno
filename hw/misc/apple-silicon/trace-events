# aes.c
apple_aes_reg_read(uint64_t addr, uint32_t val) "0x%04" PRIx64 " val 0x%08x"
apple_aes_reg_write(uint64_t addr, uint32_t orig, uint32_t old, uint32_t result) "0x%04" PRIx64 " orig 0x%08x old 0x%08x val 0x%08x"
apple_aes_update_irq(uint32_t level) "level %d"
apple_aes_process_command(uint32_t op) "op 0x%x"

# wlan.c
apple_wlan_bar0_read(uint64_t offset, unsigned size, uint64_t val) "offset 0x%05" PRIx64 " size %u val 0x%" PRIx64
apple_wlan_bar0_write(uint64_t offset, unsigned size, uint64_t val) "offset 0x%05" PRIx64 " size %u val 0x%" PRIx64
apple_wlan_tcm_written(uint64_t bytes, uint64_t offset) "TCM written: %" PRIu64 " bytes, last at bar2+0x%06" PRIx64
apple_wlan_arm_core_released(uint64_t tcm_bytes) "ARM core released after %" PRIu64 " TCM bytes"
apple_wlan_fw_alive_marker(uint32_t off, uint32_t shared, uint64_t tcm_bytes) "fw shared-memory address bar2+0x%06x <- 0x%08x (%" PRIu64 " TCM bytes written)"
apple_wlan_bar0_window(uint32_t cfg, uint32_t page, uint32_t base) "window cfg 0x%02x (bar0 page %u) <- backplane 0x%08x"
apple_wlan_backplane_read(uint32_t backplane, uint64_t offset, unsigned size, uint64_t val) "backplane 0x%08x (bar0+0x%05" PRIx64 ") size %u -> 0x%" PRIx64
apple_wlan_backplane_write(uint32_t backplane, uint64_t offset, unsigned size, uint64_t val) "backplane 0x%08x (bar0+0x%05" PRIx64 ") size %u <- 0x%" PRIx64
apple_wlan_backplane_written(uint64_t bytes, uint32_t pages, uint32_t hash) "backplane written: %" PRIu64 " bytes across %u pages, fnv1a 0x%08x"
apple_wlan_srom_read(uint32_t off, unsigned size, uint64_t val) "srom[0x%03x] size %u -> 0x%" PRIx64
apple_wlan_otp_read(uint32_t off, unsigned size, uint64_t val) "otp[0x%03x] size %u -> 0x%" PRIx64
apple_wlan_gp11_read(uint32_t val) "val 0x%08x"
apple_wlan_gp11_write(uint32_t val) "val 0x%08x"
