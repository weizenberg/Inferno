# aes.c
apple_aes_reg_read(uint64_t addr, uint32_t val) "0x%04" PRIx64 " val 0x%08x"
apple_aes_reg_write(uint64_t addr, uint32_t orig, uint32_t old, uint32_t result) "0x%04" PRIx64 " orig 0x%08x old 0x%08x val 0x%08x"
apple_aes_update_irq(uint32_t level) "level %d"
apple_aes_process_command(uint32_t op) "op 0x%x"

# wlan.c
apple_wlan_bar0_read(uint64_t offset, unsigned size, uint64_t val) "offset 0x%05" PRIx64 " size %u val 0x%" PRIx64
apple_wlan_bar0_write(uint64_t offset, unsigned size, uint64_t val) "offset 0x%05" PRIx64 " size %u val 0x%" PRIx64
apple_wlan_bar2_read(uint64_t offset, unsigned size, uint64_t val) "offset 0x%05" PRIx64 " size %u val 0x%" PRIx64
apple_wlan_bar2_write(uint64_t offset, unsigned size, uint64_t val) "offset 0x%05" PRIx64 " size %u val 0x%" PRIx64
apple_wlan_gp11_read(uint32_t val) "val 0x%08x"
apple_wlan_gp11_write(uint32_t val) "val 0x%08x"
